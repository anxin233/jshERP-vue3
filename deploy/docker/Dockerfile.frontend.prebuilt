# 使用本机已构建的前端静态资源（jshERP-web/dist），不在镜像内执行 npm。
# 本地打包须与线上子路径、API 前缀一致，例如（PowerShell）：
#   cd jshERP-web
#   $env:VUE_APP_PUBLIC_PATH='/erp/'; $env:VUE_APP_API_BASE='/erp/jshERP-boot'; yarn build
# compose：在 .env 中设置 DOCKERFILE_FRONTEND=deploy/docker/Dockerfile.frontend.prebuilt
ARG NGINX_RUNTIME_IMAGE=docker.m.daocloud.io/library/nginx:1.25-alpine
FROM ${NGINX_RUNTIME_IMAGE}
COPY deploy/docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY jshERP-web/dist /usr/share/nginx/html
EXPOSE 80
