# 构建上下文：仓库根目录（与 docker-compose 中 context 一致）
# 默认与 compose 一致：经 DaoCloud 拉 Hub 官方库。可直连 Hub 时传 --build-arg MAVEN_BUILD_IMAGE=maven:3.9-eclipse-temurin-8 等。
# 两个 ARG 必须出现在任一 FROM 之前。
ARG MAVEN_BUILD_IMAGE=docker.m.daocloud.io/library/maven:3.9-eclipse-temurin-8
ARG JRE_RUNTIME_IMAGE=docker.m.daocloud.io/library/eclipse-temurin:8-jre-alpine
FROM ${MAVEN_BUILD_IMAGE} AS build
WORKDIR /build
COPY jshERP-boot/pom.xml jshERP-boot/
COPY jshERP-boot/src jshERP-boot/src
RUN cd jshERP-boot && mvn -B -q -DskipTests package

FROM ${JRE_RUNTIME_IMAGE}
# 验证码 AWT 绘图：headless 仍需 fontconfig + 字库（按基础镜像二选一）
RUN if command -v apk >/dev/null 2>&1; then apk add --no-cache fontconfig ttf-dejavu libgcc; \
    elif command -v apt-get >/dev/null 2>&1; then apt-get update && apt-get install -y --no-install-recommends fontconfig fonts-dejavu-core && rm -rf /var/lib/apt/lists/*; \
    else echo "skip fonts (unknown base image)"; fi
WORKDIR /app
COPY --from=build /build/jshERP-boot/target/jshERP.jar /app/app.jar
EXPOSE 9999
ENTRYPOINT ["java", "-Djava.awt.headless=true", "-jar", "/app/app.jar"]
