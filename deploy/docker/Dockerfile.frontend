# 使用本机已构建的 jshERP-web/dist（镜像内不执行 npm）
# 构建前在 jshERP-web 执行 yarn build / npm run build，且与线上子路径、API 前缀一致，例如（PowerShell）：
#   cd jshERP-web
#   $env:VUE_APP_PUBLIC_PATH='/erp/'; $env:VUE_APP_API_BASE='/erp/jshERP-boot'; yarn build
# 根路径部署：dist 用 VUE_APP_PUBLIC_PATH=/ 打完包后，构建镜像时传 NGINX_CONF=deploy/docker/nginx/default-root.conf
ARG NGINX_RUNTIME_IMAGE=docker.m.daocloud.io/library/nginx:1.25-alpine
FROM ${NGINX_RUNTIME_IMAGE}
ARG NGINX_CONF=deploy/docker/nginx/default.conf
COPY ${NGINX_CONF} /etc/nginx/conf.d/default.conf
COPY jshERP-web/dist /usr/share/nginx/html
EXPOSE 80
