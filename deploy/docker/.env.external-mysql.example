# 与 docker-compose.yml 配合使用（外置 MySQL；可复制进 .env 或合并）
# 例：REGISTRY_PREFIX=harbor.aicode.ccwu.cc/erp

REGISTRY_PREFIX=harbor.aicode.ccwu.cc/erp
IMAGE_TAG=latest

# 已有 MySQL 地址：容器名 / 宿主机 IP / host.docker.internal（Docker Desktop 连宿主机）
EXTERNAL_MYSQL_HOST=host.docker.internal
EXTERNAL_MYSQL_PORT=3306
# 后端 JDBC 用户名（默认 root）；非 root 时改成实际账号，例如 jsh_erp
EXTERNAL_MYSQL_USER=root
MYSQL_DATABASE=jsh_erp
# 后端 JDBC 密码：填「上面 EXTERNAL_MYSQL_USER 在已有 MySQL 里的登录密码」
# （变量名沿用内置 MySQL 时的 MYSQL_ROOT_PASSWORD，与是否 root 无关）
MYSQL_ROOT_PASSWORD=与已有库一致的密码

REDIS_PASSWORD=
REDIS_PORT=6379

WEB_PORT=8080

VUE_APP_PUBLIC_PATH=/erp/
VUE_APP_API_BASE=/erp/jshERP-boot
