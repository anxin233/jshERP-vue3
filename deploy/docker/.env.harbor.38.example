# 复制为 .env 后使用（勿提交含真实密码的 .env）
# Harbor：http://38.226.195.139 （默认 80 可省略端口），项目 erp
# 非 80/443 时再写端口，例如 38.226.195.139:8443/erp

REGISTRY_PREFIX=38.226.195.139/erp
IMAGE_TAG=latest

MYSQL_ROOT_PASSWORD=请改为强密码
MYSQL_DATABASE=jsh_erp
MYSQL_PORT=3306

REDIS_PASSWORD=
REDIS_PORT=6379

WEB_PORT=8080

VUE_APP_PUBLIC_PATH=/erp/
VUE_APP_API_BASE=/erp/jshERP-boot

# compose 已默认 DaoCloud 代理；仅当能直连 Hub 时再改为官方短名（见 .env.example）
