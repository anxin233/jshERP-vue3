# 服务器或本机构建推 Harbor（https://harbor.aicode.ccwu.cc/）时参考，复制为 .env 后改密码与 MySQL 地址
# 镜像名不要写 https://，格式：域名/项目名  →  与 Harbor 里「项目」名称一致（示例为 erp）

REGISTRY_PREFIX=harbor.aicode.ccwu.cc/erp
IMAGE_TAG=latest

# 外置 MySQL（compose 读的是下面这些；MYSQL_PORT 不会被 compose 用于 JDBC）
EXTERNAL_MYSQL_HOST=172.17.0.1
EXTERNAL_MYSQL_PORT=3306
EXTERNAL_MYSQL_USER=root
MYSQL_DATABASE=jsh_erp
MYSQL_ROOT_PASSWORD=请改为与库一致的密码

REDIS_PASSWORD=
REDIS_PORT=6379

WEB_PORT=8080

VUE_APP_PUBLIC_PATH=/erp/
VUE_APP_API_BASE=/erp/jshERP-boot

# 构建 jsherp-redis 时的基底；服务器仅 pull 时可忽略
# REDIS_IMAGE=redis:7-alpine

# 本机 prebuilt 构建时取消注释：
# DOCKERFILE_BACKEND=deploy/docker/Dockerfile.backend.prebuilt
# DOCKERFILE_FRONTEND=deploy/docker/Dockerfile.frontend.prebuilt
