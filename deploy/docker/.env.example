# 复制为 .env 后修改
# compose 不含内置 MySQL：须配置 EXTERNAL_MYSQL_*，库中先导入 jsh_erp.sql
# Harbor：业务镜像为 ${REGISTRY_PREFIX}/jsherp-redis|jsherp-boot|jsherp-web:${IMAGE_TAG}

REGISTRY_PREFIX=local
IMAGE_TAG=latest

# 已有 MySQL（容器名 / 宿主机 IP / host.docker.internal）
EXTERNAL_MYSQL_HOST=host.docker.internal
EXTERNAL_MYSQL_PORT=3306
EXTERNAL_MYSQL_USER=root
MYSQL_DATABASE=jsh_erp
# JDBC 密码（变量名沿用 MYSQL_ROOT_PASSWORD）
MYSQL_ROOT_PASSWORD=root

# 与 compose 中 redis 无密码一致；若给 Redis 加密码，需改 docker-compose 中 redis command 并设此处
REDIS_PASSWORD=
REDIS_PORT=6379

# 浏览器访问前端（Nginx）
WEB_PORT=8080

# 前端子路径部署（与 deploy/docker/nginx/default.conf 中 /erp 一致）
# 根路径部署时保持：VUE_APP_PUBLIC_PATH=/  且 VUE_APP_API_BASE 留空
VUE_APP_PUBLIC_PATH=/erp/
VUE_APP_API_BASE=/erp/jshERP-boot

# compose 已默认走 DaoCloud Hub 代理；若能直连 Docker Hub，可取消注释改回官方短名：
# REDIS_IMAGE=redis:7-alpine
# （作为 Dockerfile.redis 的基底，打出的运行镜像名为 ${REGISTRY_PREFIX}/jsherp-redis）
# NODE_BUILD_IMAGE=node:20-alpine
# NGINX_RUNTIME_IMAGE=nginx:1.25-alpine
# MAVEN_BUILD_IMAGE=maven:3.9-eclipse-temurin-8
# JRE_RUNTIME_IMAGE=eclipse-temurin:8-jre-alpine

# 本机先 yarn build 出 jshERP-web/dist 后，Docker 只打 Nginx 层（不在容器里 npm）：
# DOCKERFILE_FRONTEND=deploy/docker/Dockerfile.frontend.prebuilt
# 本机 mvn -f jshERP-boot package 后，后端镜像只拷 JAR（须存在 target/jshERP.jar）：
# DOCKERFILE_BACKEND=deploy/docker/Dockerfile.backend.prebuilt
