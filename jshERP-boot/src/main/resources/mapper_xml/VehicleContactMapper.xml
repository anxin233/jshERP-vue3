<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jsh.erp.datasource.mappers.VehicleContactMapper">

    <resultMap id="BaseResultMap" type="com.jsh.erp.datasource.entities.VehicleContact">
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="vehicle_id"    jdbcType="BIGINT"   property="vehicleId"/>
        <result column="contact_name"  jdbcType="VARCHAR"  property="contactName"/>
        <result column="contact_phone" jdbcType="VARCHAR"  property="contactPhone"/>
        <result column="tenant_id"     jdbcType="BIGINT"   property="tenantId"/>
        <result column="delete_flag"   jdbcType="VARCHAR"  property="deleteFlag"/>
        <result column="create_time"   jdbcType="TIMESTAMP" property="createTime"/>
    </resultMap>

    <insert id="insertSelective" parameterType="com.jsh.erp.datasource.entities.VehicleContact"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        insert into jsh_vehicle_contact
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="vehicleId != null">vehicle_id,</if>
            <if test="contactName != null">contact_name,</if>
            <if test="contactPhone != null">contact_phone,</if>
            <if test="tenantId != null">tenant_id,</if>
            <if test="createTime != null">create_time,</if>
            delete_flag,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="vehicleId != null">#{vehicleId},</if>
            <if test="contactName != null">#{contactName},</if>
            <if test="contactPhone != null">#{contactPhone},</if>
            <if test="tenantId != null">#{tenantId},</if>
            <if test="createTime != null">#{createTime},</if>
            '0',
        </trim>
    </insert>

</mapper>
