<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jsh.erp.datasource.mappers.OptionItemMapperEx">

    <resultMap id="BaseResultMap" type="com.jsh.erp.datasource.entities.OptionItem">
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="group_code"   jdbcType="VARCHAR"   property="groupCode"/>
        <result column="tenant_id"    jdbcType="BIGINT"    property="tenantId"/>
        <result column="value"        jdbcType="VARCHAR"   property="value"/>
        <result column="label"        jdbcType="VARCHAR"   property="label"/>
        <result column="sort"         jdbcType="INTEGER"   property="sort"/>
        <result column="enabled"      jdbcType="BIT"       property="enabled"/>
        <result column="is_default"   jdbcType="BIT"       property="isDefault"/>
        <result column="hidden"       jdbcType="BIT"       property="hidden"/>
        <result column="create_time"  jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_time"  jdbcType="TIMESTAMP" property="updateTime"/>
        <result column="delete_flag"  jdbcType="CHAR"      property="deleteFlag"/>
    </resultMap>

    <!-- 业务使用：按组+租户取所有可用选项（含系统级+租户级，在 Service 中合并） -->
    <select id="listByGroupAndTenant" resultMap="BaseResultMap">
        select *
        from jsh_option_item
        where ifnull(delete_flag,'0') != '1'
          and group_code = #{groupCode}
          and (tenant_id is null or tenant_id = #{tenantId})
        order by sort asc, id asc
    </select>

    <!-- 管理界面：仅查当前租户的选项，租户只看到、只操作自己的数据 -->
    <select id="listForManage" resultMap="BaseResultMap">
        select *
        from jsh_option_item
        where ifnull(delete_flag,'0') != '1'
          and tenant_id = #{tenantId}
        <if test="groupCode != null and groupCode != ''">
          and group_code = #{groupCode}
        </if>
        <if test="label != null and label != ''">
          and label like concat('%', #{label}, '%')
        </if>
        order by group_code asc, sort asc, id asc
    </select>

    <select id="countByGroupAndTenant" resultType="int">
        select count(*) from jsh_option_item
        where ifnull(delete_flag,'0') != '1'
          and tenant_id = #{tenantId}
          and group_code = #{groupCode}
    </select>

    <select id="listSystemByGroupCode" resultMap="BaseResultMap">
        select * from jsh_option_item
        where ifnull(delete_flag,'0') != '1'
          and tenant_id is null
          and group_code = #{groupCode}
        order by sort asc, id asc
    </select>

</mapper>

