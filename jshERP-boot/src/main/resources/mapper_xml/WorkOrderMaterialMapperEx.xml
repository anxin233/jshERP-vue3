<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jsh.erp.datasource.mappers.WorkOrderMaterialMapperEx">

  <resultMap id="MaterialItemMap" type="com.jsh.erp.datasource.entities.WorkOrderMaterial">
    <id     column="id"            property="id" />
    <result column="order_id"      property="orderId" />
    <result column="material_id"   property="materialId" />
    <result column="material_name" property="materialName" />
    <result column="standard"      property="standard" />
    <result column="model"         property="model" />
    <result column="unit"          property="unit" />
    <result column="unit_price"    property="unitPrice" />
    <result column="quantity"      property="quantity" />
    <result column="discount_rate" property="discountRate" />
    <result column="amount"        property="amount" />
    <result column="remark"        property="remark" />
    <result column="sort"          property="sort" />
  </resultMap>

  <select id="getByOrderId" resultMap="MaterialItemMap">
    select * from jsh_work_order_material
    where order_id = #{orderId}
    order by sort asc, id asc
  </select>

  <delete id="deleteByOrderId">
    delete from jsh_work_order_material where order_id = #{orderId}
  </delete>

  <delete id="deleteByOrderIds">
    delete from jsh_work_order_material
    where order_id in (
    <foreach collection="orderIds" item="id" separator=",">#{id}</foreach>
    )
  </delete>

  <insert id="batchInsert">
    insert into jsh_work_order_material
    (order_id, material_id, material_name, standard, model, unit,
     unit_price, quantity, discount_rate, amount, remark, sort)
    values
    <foreach collection="list" item="item" separator=",">
      (#{item.orderId}, #{item.materialId}, #{item.materialName}, #{item.standard},
       #{item.model}, #{item.unit}, #{item.unitPrice}, #{item.quantity},
       #{item.discountRate}, #{item.amount}, #{item.remark}, #{item.sort})
    </foreach>
  </insert>

</mapper>
